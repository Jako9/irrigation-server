# Use a long random value that exactly matches the firmware bearer secret.
IRRIGATION_SHARED_SECRET=replace-with-a-long-random-secret

# Generic local defaults. Set the host to a LAN address only when the controller
# must reach this process directly.
IRRIGATION_HOST=127.0.0.1
IRRIGATION_PORT=8070
IRRIGATION_ALLOWED_SUBNET=127.0.0.1/32
IRRIGATION_DATA_DIR=./data
IRRIGATION_MANAGEMENT_DIR=./data/management

# Optional retention settings (bytes).
# IRRIGATION_MAX_LOG_BYTES=1048576
# IRRIGATION_MAX_DB_BYTES=10737418240
# IRRIGATION_RETENTION_TARGET_BYTES=9663676416
# IRRIGATION_DELETE_BATCH_BYTES=1073741824
